# Copy to .env and change every secret.
POSTGRES_PASSWORD=change-me-db
DATABASE_URL=postgresql+psycopg://soroka:change-me-db@db:5432/soroka
REDIS_URL=redis://redis:6379/0
CONNECTOR_TOKEN=change-me-long-random
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin
# public hostname[:port] for TLS. Production: docs.example.com (Caddy gets a Lets Encrypt cert, set HTTPS_PORT=443, HTTP_PORT=80).
# Local: localhost:8443 (Caddy local CA; browser warns once)
SITE_ADDRESS=localhost:8443
HTTP_PORT=8080
HTTPS_PORT=8443
COOKIE_SECURE=true
# optional: malware scan (start with: docker compose --profile security up -d)
CLAMAV_HOST=
# optional: alert emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL=
